# Copy to .env and fill in. .env is git-ignored - never commit real keys.
GROQ_API_KEY=
# Groq chat model used by the flight copilot (reasoning only - never perception).
GROQ_MODEL=openai/gpt-oss-120b
# Optional: path to a SAM 3D Body checkpoint (requires an NVIDIA CUDA GPU).
SAM3D_CHECKPOINT=models/sam3d/model.ckpt
# Fallback chat model and speech-to-text model for voice commands.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
