{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/api/:path*" },
    { "source": "/recordings/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/recordings/:path*" },
    { "source": "/reports/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/reports/:path*" },
    { "source": "/tags", "destination": "https://YOUR-BACKEND.up.railway.app/tags" },
    { "source": "/presentation", "destination": "/sih_presentation.html" },
    { "source": "/app", "destination": "/console.html" },
    { "source": "/workspace", "destination": "/console.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), microphone=(self)" }]
    }
  ]
}
