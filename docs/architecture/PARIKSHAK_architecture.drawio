<mxfile host="app.diagrams.net" type="device"><diagram id="parikshak-arch" name="PARIKSHAK architecture"><mxGraphModel dx="1660" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ground" value="GROUND SEGMENT  ·  development &amp; training  ·  internet allowed" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#eeeeee;swimlaneFillColor=#fafafa;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=14;align=left;spacingLeft=10;rounded=1;arcSize=2;strokeWidth=2;dashed=1;container=0;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1640" height="180" as="geometry"/></mxCell><mxCell id="flight" value="ON-BOARD EDGE BOX  ·  NVIDIA Jetson Orin Nano (4 GB)  ·  fully offline, no internet connection" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#0B2545;swimlaneFillColor=#ffffff;strokeColor=#0B2545;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=10;rounded=1;arcSize=2;strokeWidth=3;container=0;" vertex="1" parent="1"><mxGeometry x="10" y="250" width="1640" height="740" as="geometry"/></mxCell><mxCell id="c1" value="1 · SENSE &amp; CAPTURE" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#fafafa;swimlaneFillColor=#fafafa;strokeColor=#666666;fontColor=#444444;fontStyle=1;fontSize=13;align=left;spacingLeft=10;rounded=1;arcSize=2;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="25" y="294" width="306" height="536" as="geometry"/></mxCell><mxCell id="c2" value="2 · PERCEIVE  (TensorRT)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f4f8fd;swimlaneFillColor=#f4f8fd;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontStyle=1;fontSize=13;align=left;spacingLeft=10;rounded=1;arcSize=2;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="351" y="294" width="306" height="536" as="geometry"/></mxCell><mxCell id="c3" value="3 · UNDERSTAND" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f5faf4;swimlaneFillColor=#f5faf4;strokeColor=#82b366;fontColor=#82b366;fontStyle=1;fontSize=13;align=left;spacingLeft=10;rounded=1;arcSize=2;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="677" y="294" width="306" height="536" as="geometry"/></mxCell><mxCell id="c4" value="4 · DECIDE" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#fffcf2;swimlaneFillColor=#fffcf2;strokeColor=#d6b656;fontColor=#d6b656;fontStyle=1;fontSize=13;align=left;spacingLeft=10;rounded=1;arcSize=2;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="1003" y="294" width="306" height="536" as="geometry"/></mxCell><mxCell id="c5" value="5 · ACT &amp; RECORD" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#fff9f2;swimlaneFillColor=#fff9f2;strokeColor=#d79b00;fontColor=#d79b00;fontStyle=1;fontSize=13;align=left;spacingLeft=10;rounded=1;arcSize=2;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="1329" y="294" width="306" height="536" as="geometry"/></mxCell><mxCell id="comms" value="6 · COMMS MANAGER  —  store &amp; forward: sends only when the station link is available, highest priority first" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#faf6fc;swimlaneFillColor=#faf6fc;strokeColor=#9673a6;fontColor=#7a5a8c;fontStyle=1;fontSize=13;align=left;spacingLeft=10;rounded=1;arcSize=2;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="25" y="845" width="1610" height="135" as="geometry"/></mxCell><mxCell id="airgap_line" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=3;strokeColor=#c0392b;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="10" y="220" as="sourcePoint"/><mxPoint x="1650" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="airgap_tag" value="AIR GAP" style="rounded=1;arcSize=50;html=1;fillColor=#c0392b;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="32" y="206" width="104" height="28" as="geometry"/></mxCell><mxCell id="airgap_txt" value="update package (models + procedure files) is installed on the ground before flight · no live internet link" style="text;html=1;fillColor=#ffffff;fontColor=#7b241c;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="146" y="206" width="760" height="28" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b style='font-size:16px'&gt;Dataset capture&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;team webcam runs on a mock rack; camera rolled 0°, 90°, 180°, 270°&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="25" y="52" width="250" height="124" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b style='font-size:16px'&gt;Annotation (CVAT)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;objects, body &amp;amp; hand keypoints, contact state, step start / end&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="297" y="52" width="250" height="124" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b style='font-size:16px'&gt;Augmentation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;random 3D rotation, glare, blur, partial occlusion&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="569" y="52" width="250" height="124" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b style='font-size:16px'&gt;Training&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;PyTorch + Ultralytics; preliminary runs on university NVIDIA DGX&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="841" y="52" width="250" height="124" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b style='font-size:16px'&gt;Export&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;ONNX → TensorRT engines (FP16 / INT8) for Jetson&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1113" y="52" width="250" height="124" as="geometry"/></mxCell><mxCell id="g6" value="&lt;b style='font-size:16px'&gt;Procedure authoring&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;PDL files, human-reviewed; Groq LLM drafting in prototype only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1385" y="52" width="250" height="124" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b style='font-size:16px'&gt;Fixed payload camera&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;USB3 wide-angle camera, fixed to the rack&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="35" y="334" width="286" height="105" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b style='font-size:16px'&gt;GStreamer capture&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;one camera feed → AI, recorder and live stream&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="35" y="461" width="286" height="105" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b style='font-size:16px'&gt;Record + live stream&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;H.264 MP4 segments on NVMe; RTSP (MediaMTX) → configured IP&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="35" y="588" width="286" height="105" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b style='font-size:16px'&gt;AprilTag markers&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;4 fixed tags on the rack face define the rack frame&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="35" y="715" width="286" height="105" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b style='font-size:16px'&gt;Object detector&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;YOLOv8n, custom-trained: outer box, red box, yellow box, hand&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="361" y="334" width="286" height="105" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b style='font-size:16px'&gt;Body pose (2D + 3D)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;17 keypoints (YOLOv8n-pose) + 3D landmarks (MediaPipe)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="361" y="461" width="286" height="105" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b style='font-size:16px'&gt;Hand landmarks&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;21 keypoints per hand (MediaPipe Hands)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="361" y="588" width="286" height="105" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b style='font-size:16px'&gt;Rack lock&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;AprilTag detection + solvePnP → camera pose in rack frame&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="361" y="715" width="286" height="105" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b style='font-size:16px'&gt;Rack-frame fusion&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;body joints + objects in rack X, Y, Z — same result upright or inverted&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="687" y="334" width="286" height="105" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b style='font-size:16px'&gt;Hand–object contact&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;none · touch · grasp · release&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="687" y="461" width="286" height="105" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b style='font-size:16px'&gt;Motion classifier&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;TCN over a 2 s window: reach, lift, place, withdraw&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="687" y="588" width="286" height="105" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b style='font-size:16px'&gt;Belief frame&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;one fused state per frame, handed to the engine&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="687" y="715" width="286" height="105" as="geometry"/></mxCell><mxCell id="n41" value="&lt;b style='font-size:16px'&gt;Procedure file (PDL)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;steps, objects, evidence rules, allowed re-orders&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1013" y="334" width="286" height="105" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b style='font-size:16px'&gt;HSMM step tracker&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;current step + confidence, using step-duration priors&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1013" y="461" width="286" height="105" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b style='font-size:16px'&gt;Deviation rules&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;skip · out-of-order · wrong object · repeat · timing · loose object&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1013" y="588" width="286" height="105" as="geometry"/></mxCell><mxCell id="n44" value="&lt;b style='font-size:16px'&gt;Alert policy&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;confidence + persistence gate; else “cannot verify” → ask crew&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1013" y="715" width="286" height="105" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b style='font-size:16px'&gt;Voice (offline)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;speaks next step &amp;amp; alerts (Piper, EN / HI); crew confirms by voice (Vosk)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1339" y="334" width="286" height="105" as="geometry"/></mxCell><mxCell id="n52" value="&lt;b style='font-size:16px'&gt;Operator GUI&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;local web console on crew tablet: video, checklist, alerts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1339" y="461" width="286" height="105" as="geometry"/></mxCell><mxCell id="n53" value="&lt;b style='font-size:16px'&gt;Event log &amp;amp; report&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;timestamped JSONL, SHA-256 chained; TXT / PDF report&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1339" y="588" width="286" height="105" as="geometry"/></mxCell><mxCell id="n54" value="&lt;b style='font-size:16px'&gt;Alert clips&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;±10 s of video around each alert, kept on local disk&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1339" y="715" width="286" height="105" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b style='font-size:15px'&gt;P1  Event log&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;kilobytes — always sent first&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="886" width="320" height="82" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b style='font-size:15px'&gt;P2  Alert clips&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;megabytes — visual evidence&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="375" y="886" width="320" height="82" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b style='font-size:15px'&gt;P3  3D pose replay&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;≈ 2 KB/s — avat